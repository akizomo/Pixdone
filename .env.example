# ─────────────────────────────────────────────────────────────────────────────
# PixDone 環境変数テンプレート
#
# このファイルをコピーして .env を作成してください。
#   cp .env.example .env
#
# ⚠️  .env は .gitignore に含まれています。絶対にコミットしないでください。
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase の接続文字列（Transaction Pooler / Port 6543 を使用）
# Supabase ダッシュボード → Settings → Database → Connection string で確認
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ─── Session ─────────────────────────────────────────────────────────────────
# ランダムな文字列（32文字以上推奨）
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-chars-string

# ─── Google OAuth（任意）────────────────────────────────────────────────────
# Google Cloud Console → OAuth 2.0 クライアント ID で発行
# 不要な場合は空欄のままにしてください
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Billing ─────────────────────────────────────────────────────────────────
# true にすると PricingPage のアップグレードボタンが有効になる（Stripe 本番準備完了後に設定）
VITE_BILLING_LIVE=true

# ─── Stripe ──────────────────────────────────────────────────────────────────
# ステージング: sk_test_... キーを使用
# 本番環境:     sk_live_... キーを使用
#
# Stripe ダッシュボード → Developers → API keys で確認
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe ダッシュボード → Products で作成した Price ID
STRIPE_PRICE_PLUS_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PLUS_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe ダッシュボード → Developers → Webhooks で確認
# ローカル開発: stripe listen --forward-to localhost:5000/api/billing/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Firebase Admin SDK（任意）──────────────────────────────────────────────
# Firebase コンソール → プロジェクトの設定 → サービスアカウント → 新しい秘密鍵を生成
# 不要な場合は空欄のままにしてください
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Node.js ─────────────────────────────────────────────────────────────────
# development | staging | production
NODE_ENV=development
