rules_version = '2';

// PixDone Firestore Security Rules（推奨案）
// Phase 1: フラットコレクション tasks, lists を uid でフィルタ
// デプロイ: firebase deploy --only firestore

service cloud.firestore {
  match /databases/{database}/documents {

    // lists コレクション: 認証ユーザーは自らの uid のドキュメントのみ読み書き可
    match /lists/{listId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // tasks コレクション: 認証ユーザーは自らの uid のドキュメントのみ読み書き可
    match /tasks/{taskId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // themeStats コレクション: テーマ別の累計タスク完了数
    match /themeStats/{docId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // activityDays コレクション: 直近7日間のログイン日記録
    match /activityDays/{docId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // users/{uid}/settings/* サブコレクション: オンボーディング等のユーザー設定
    // 本人のみ読み書き可。Firestore を権威データとして全端末で同期するため必須。
    match /users/{userId}/settings/{settingId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }
  }
}
